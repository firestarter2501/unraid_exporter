# Every setting of unraid_exporter is an environment variable.
# Required:
UNRAID_URL=http://192.168.1.10
UNRAID_API_KEY=change-me
# Alternatively read the key from a file inside the container (readable by uid 65532):
# UNRAID_API_KEY_FILE=/run/secrets/unraid-api-key

# Optional (defaults shown):
# UNRAID_INSECURE_SKIP_VERIFY=false
# UNRAID_TIMEOUT=10s
# UNRAID_EXPORTER_COLLECTORS=array,docker,info,metrics,network,notifications,shares,temperature,ups,vms
# UNRAID_EXPORTER_NETWORK_EXCLUDE=^(lo|veth.*)$
# UNRAID_EXPORTER_LISTEN_ADDRESS=:9703
# UNRAID_EXPORTER_TELEMETRY_PATH=/metrics
# UNRAID_EXPORTER_LOG_LEVEL=info
