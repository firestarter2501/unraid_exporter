# HELP unraid_boot_time_seconds Unix time the server booted.
# TYPE unraid_boot_time_seconds gauge
unraid_boot_time_seconds 1.7908128e+09
# HELP unraid_cpu_cores Number of physical CPU cores.
# TYPE unraid_cpu_cores gauge
unraid_cpu_cores 8
# HELP unraid_cpu_frequency_hertz CPU base frequency.
# TYPE unraid_cpu_frequency_hertz gauge
unraid_cpu_frequency_hertz 3.8e+09
