# TYPE unraid_cpu_frequency_max_hertz gauge
unraid_cpu_frequency_max_hertz 4.6e+09
# HELP unraid_cpu_threads Number of CPU threads.
# TYPE unraid_cpu_threads gauge
unraid_cpu_threads 16
