# HELP unraid_exporter_collector_success Whether the collector succeeded.
# TYPE unraid_exporter_collector_success gauge
unraid_exporter_collector_success{collector="shares"} 1
# HELP unraid_share_free_bytes Free space available to the share.
# TYPE unraid_share_free_bytes gauge
unraid_share_free_bytes{name="appdata"} 4.88204853248e+11
